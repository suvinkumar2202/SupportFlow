# Database Configuration
# SQLite: path to the database file (relative to the backend working directory)
DB_PATH=supportflow.db

# Server Port
PORT=8080

# JWT Configuration
# HS256 requires a secret key of at least 256 bits (32 bytes / 32 characters)
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes_long_for_security_compliance
# Token validity duration in milliseconds (e.g. 86400000 ms for 24 hours)
JWT_EXPIRATION=86400000
