# ---------------------------------------------------------------------------
# Copy this file to ".env" in the backend directory and fill in real values.
# The backend loads .env automatically (see SupportFlowApplication).
# .env is gitignored - never commit real credentials.
# ---------------------------------------------------------------------------

# MySQL Connection
# Host: localhost | Port: 3306 | Database: supportflow_db | Username: root
DB_URL=jdbc:mysql://localhost:3306/supportflow_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Server Port
PORT=8080

# JWT Configuration
# HS256 requires a secret key of at least 256 bits (32 bytes / 32 characters)
JWT_SECRET=
# Token validity duration in milliseconds (e.g. 86400000 ms for 24 hours)
JWT_EXPIRATION=86400000

# CORS - comma-separated list of allowed frontend origins.
# Keep http://localhost:5173 for local development; add the Vercel URL for production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:5000,http://localhost:8080,https://supportflow-frontend-sigma.vercel.app
